# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Anthropic API key for the resolution agent (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Sandbox buyer (developer.paypal.com > Testing Tools > Sandbox Accounts > Personal)
# Used only by the scripts that simulate the buyer side.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Optional: path to a Chromium binary for the buyer simulator
CHROMIUM_PATH=
